# cbs-nova — local development environment variables.
#
# Copy to `.env` (which is gitignored) and adjust as needed. This file is the
# single source of truth for values shared by `docker compose`, the Spring
# Boot backend, and the Nuxt frontend.

# --- Temporal ---------------------------------------------------------------
# Consumed by the backend via the `TEMPORAL_ADDRESS` env var. Inside the
# docker network the hostname is `temporal`; from the host it is `localhost`.
# `docker-compose.yml` already wires `temporal:7233` for the `spring-app`
# service.
TEMPORAL_ADDRESS=temporal:7233

# --- Keycloak ---------------------------------------------------------------
# Public URL for the local Keycloak realm used by the frontend (BFF) and by
# integration tests. The admin console lives at /admin/master/console/.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=master
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Bugsink (Sentry-compatible error tracking) -----------------------------
# Bugsink DSN consumed by the backend. The placeholder below points at the
# in-cluster DSN for the default project created by the `bugsink` container
# (its `CREATE_SUPERUSER=admin:admin` env seeds project id 1). Switch the
# hostname to `localhost` when running the backend on the host.
BUGSINK_DSN=http://admin:admin@bugsink:8000/?project=1

# --- Host-side service ports (must match docker-compose.yml) ---------------
POSTGRES_KEYCLOAK_PORT=5433
KEYCLOAK_PORT=8080
BUGSINK_PORT=8000
TEMPORAL_GRPC_PORT=7233
TEMPORAL_UI_PORT=8233
BACKEND_PORT=8090