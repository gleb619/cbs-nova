    {
      "id": 14,
      "type": "timeseries",
      "title": "Maintenance task purge rate by task",
      "description": "Rows purged per second by unified maintenance task, split by task tag (dsl.maintenance.task.purged counter).",
      "datasource": { "type": "prometheus", "uid": "cbs-nova-prometheus" },
