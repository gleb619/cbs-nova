# cbs-nova — editor conventions (single source of truth).
# Values cross-checked against backend/gradle/eclipse-formatter.xml
# (tabulation.size=2, spaces) and frontend/biome.json (indentWidth=2, spaces).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{java,ts,vue,js,mjs,cjs,json,yml,yaml,gradle}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.mk]
indent_style = tab
