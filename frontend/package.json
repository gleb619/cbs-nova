{
  "name": "@cbs/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "BACKEND_BASE_URL=http://localhost:${BACKEND_BASE_PORT:-8080} pnpm --filter @cbs/admin-ui-plugin dev",
    "build": "pnpm --filter @cbs/admin-ui-plugin build",
    "build:components": "pnpm --filter components build",
    "test": "pnpm --filter @cbs/admin-ui-plugin --filter @cbs/components --no-bail run test",
    "typecheck": "pnpm --filter @cbs/admin-ui-plugin --filter @cbs/components --no-bail run typecheck",
    "test:plugin": "pnpm --filter @cbs/admin-ui-plugin test",
    "test:components": "pnpm --filter @cbs/components test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "ci": "biome ci .",
    "sbom": "node scripts/sbom-merge.mjs",
    "gen:api-types": "node scripts/gen-api-types.mjs",
    "check:api-types": "node scripts/gen-api-types.mjs --check",
    "audit:prod": "pnpm audit --prod --audit-level high"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@cyclonedx/cyclonedx-npm": "6.0.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^26.4.0",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.4.0"
  }
}
