{
  "name": "@cbs/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "BACKEND_BASE_URL=http://localhost:${BACKEND_BASE_PORT:-8080} pnpm --filter @cbs/admin-ui-plugin dev",
    "build": "pnpm --filter @cbs/admin-ui-plugin build",
    "build:components": "pnpm --filter components build",
    "test": "pnpm --filter @cbs/admin-ui-plugin test",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "ci": "biome ci .",
    "test:components": "pnpm --filter components test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "typescript": "^5.4.0"
  }
}
