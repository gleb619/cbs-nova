{
  "name": "@cbs/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter admin-ui dev",
    "build": "pnpm --filter admin-ui build",
    "build:components": "pnpm --filter components build",
    "test": "pnpm --filter admin-ui test",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "ci": "biome ci ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "typescript": "^5.4.0"
  }
}
