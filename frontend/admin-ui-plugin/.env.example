# Backend base URL used by the Nitro BFF to proxy authenticated requests.
NUXT_API_BASE_URL=http://localhost:8080

# Secret for signing admin-ui-plugin session cookies. Change in production.
NUXT_SESSION_SECRET=change-me-in-production

# BFF: Spring Boot backend the Nitro server routes proxy to.
BACKEND_BASE_URL=http://localhost:8090

# BFF: optional API key sent as X-Api-Key to the backend.
BACKEND_API_KEY=
