{
  "name": "@cbs/admin-ui-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./module.ts",
  "exports": {
    ".": "./module.ts",
    "./composables/*": "./app/composables/*.ts",
    "./server/utils/httpClient": "./dist/server/utils/httpClient.js",
    "./server/*": "./dist/server/*"
  },
  "scripts": {
    "dev": "NUXT_CONFIG_FILE=nuxt.config.dev.ts nuxt dev --cwd .",
    "build": "nuxt build --config nuxt.config.dev.ts --cwd .",
    "generate": "nuxt generate --config nuxt.config.dev.ts --cwd .",
    "preview": "nuxt preview",
    "test": "vitest run",
    "lint": "biome lint .",
    "test:watch": "vitest",
    "build:server": "files=$(find server -type f -name '*.ts' ! -name '*.spec.ts') && pnpm exec esbuild $files --outdir=dist/server --platform=node --format=esm --bundle=false && find dist/server -name '*.js' -exec sed -i 's|from \"~/server/utils/httpClient\"|from \"@cbs/admin-ui-plugin/server/utils/httpClient\"|g' {} +"
  },
  "dependencies": {
    "@nuxt/kit": "^3.11.0",
    "@pinia/nuxt": "^0.5.0",
    "autoprefixer": "^10.4.0",
    "h3": "2.0.1-rc.26",
    "nuxt": "^3.11.0",
    "ofetch": "^1.5.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/ui": "^2.1.0",
    "@vue/test-utils": "^2.4.0",
    "happy-dom": "^17.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "@cbs/components": "0.0.0"
  },
  "peerDependenciesMeta": {
    "@cbs/components": {
      "optional": false
    }
  }
}
