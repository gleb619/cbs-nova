{
  "name": "@cbs/admin-ui-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./module.ts",
  "exports": {
    ".": "./module.ts",
    "./composables/*": "./app/composables/*.ts",
    "./server/utils/httpClient": "./dist/server/utils/httpClient.js",
    "./server/utils/proxyFromManifest": "./dist/server/utils/proxyFromManifest.js",
    "./server/*": "./dist/server/*"
  },
  "scripts": {
    "dev": "NUXT_CONFIG_FILE=nuxt.config.dev.ts nuxt dev --cwd .",
    "build": "nuxt build --config nuxt.config.dev.ts --cwd .",
    "generate": "nuxt generate --config nuxt.config.dev.ts --cwd .",
    "preview": "nuxt preview",
    "pretest": "nuxi prepare",
    "test": "vitest run",
    "typecheck": "nuxi typecheck",
    "lint": "biome lint .",
    "test:watch": "vitest",
    "build:server": "files=$(find server -type f -name '*.ts' ! -name '*.spec.ts') && pnpm exec esbuild $files --outdir=dist/server --platform=node --format=esm --bundle=false && find dist/server -name '*.js' -exec sed -i -E 's|from \"~/server/utils/([^.\"]+)\"|from \"@cbs/admin-ui-plugin/server/utils/\\1.js\"|g' {} + && mkdir -p dist/server/api/v1/generated && cp server/api/v1/generated/manifest.json dist/server/api/v1/generated/manifest.json && sed -i -E 's|(routes/[^\"]+)\\.ts\"|\\1.js\"|g' dist/server/api/v1/generated/manifest.json"
  },
  "dependencies": {
    "@cbs/components": "workspace:*",
    "@nuxt/kit": "^4.6.4",
    "@tailwindcss/postcss": "^4.3.4",
    "@vueuse/core": "^15.0.0",
    "autoprefixer": "^10.6.2",
    "h3": "^2.0.8",
    "nuxt": "^4.6.4",
    "ofetch": "^1.5.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/ui": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "esbuild": "^0.28.2",
    "happy-dom": "21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": {
    "nuxt": "^4.x",
    "vue": "^3.5.x"
  }
}
