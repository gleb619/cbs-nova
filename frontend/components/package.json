    "autoprefixer": "^10.4.0",
    "happy-dom": "^17.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.0.0"
  }
