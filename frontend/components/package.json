{
  "name": "@cbs/components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/types/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./tailwind.config": "./src/tailwind.config.ts",
    "./types": "./src/types/index.ts",
    "./types/dsl": "./src/types/dsl.ts",
    "./types/execution": "./src/types/execution.ts",
    "./types/runner": "./src/types/runner.ts",
