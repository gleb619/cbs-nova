{
  "name": "@cbs/components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/types/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./tailwind.config": {
      "import": "./src/tailwind.config.ts",
      "types": "./src/tailwind.config.ts"
    },
    "./types": {
      "import": "./src/types/index.ts",
      "types": "./src/types/index.ts"
    },
    "./types/dsl": {
      "import": "./src/types/dsl.ts",
      "types": "./src/types/dsl.ts"
    },
    "./types/events": {
      "import": "./src/types/events.ts",
      "types": "./src/types/events.ts"
    },
    "./types/api": {
      "import": "./src/types/api.ts",
      "types": "./src/types/api.ts"
    },
    "./types/execution": {
      "import": "./src/types/execution.ts",
      "types": "./src/types/execution.ts"
    },
    "./types/runner": {
      "import": "./src/types/runner.ts",
      "types": "./src/types/runner.ts"
    },
    "./composables": {
      "import": "./src/composables/index.ts",
      "types": "./src/composables/index.ts"
    },
    "./utils/*": {
      "import": "./src/utils/*",
      "types": "./src/utils/*"
    },
    "./src/*": {
      "import": "./src/*",
      "types": "./src/*"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "marked": "^12.0.0",
    "monaco-editor": "^0.56.0",
    "monaco-editor-vue3": "^1.0.5",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "@vue/test-utils": "^2.4.0",
    "autoprefixer": "^10.4.0",
    "happy-dom": "^17.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.0.0"
  }
}
