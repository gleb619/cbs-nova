{
  "name": "@cbs/components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/types/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./tailwind.config": {
      "import": "./src/tailwind.config.ts",
      "require": "./src/tailwind.config.ts",
      "default": "./src/tailwind.config.ts",
      "types": "./src/tailwind.config.ts"
    },
    "./types": {
      "import": "./src/types/index.ts",
      "types": "./src/types/index.ts"
    },
    "./types/dsl": {
      "import": "./src/types/dsl.ts",
      "types": "./src/types/dsl.ts"
    },
    "./types/events": {
      "import": "./src/types/events.ts",
      "types": "./src/types/events.ts"
    },
    "./types/api": {
      "import": "./src/types/api.ts",
      "types": "./src/types/api.ts"
    },
    "./types/execution": {
      "import": "./src/types/execution.ts",
      "types": "./src/types/execution.ts"
    },
    "./types/runner": {
      "import": "./src/types/runner.ts",
      "types": "./src/types/runner.ts"
    },
    "./composables": {
      "import": "./src/composables/index.ts",
      "types": "./src/composables/index.ts"
    },
    "./utils/*": {
      "import": "./src/utils/*",
      "types": "./src/utils/*"
    },
    "./src/*": {
      "import": "./src/*",
      "types": "./src/*"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "dompurify": "3.4.18",
    "marked": "^18.2.1",
    "mermaid": "^12.3.0",
    "monaco-editor": "^0.57.0",
    "monaco-editor-vue3": "^1.0.5",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/test-utils": "^2.6.0",
    "autoprefixer": "^10.6.2",
    "happy-dom": "21.0.4",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
