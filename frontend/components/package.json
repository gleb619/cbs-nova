{
  "name": "@cbs/components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/types/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./tailwind.config": {
      "import": "./src/tailwind.config.ts",
      "require": "./src/tailwind.config.ts",
      "default": "./src/tailwind.config.ts",
      "types": "./src/tailwind.config.ts"
    },
    "./types": {
      "import": "./src/types/index.ts",
      "types": "./src/types/index.ts"
    },
    "./types/dsl": {
      "import": "./src/types/dsl.ts",
      "types": "./src/types/dsl.ts"
    },
    "./types/events": {
      "import": "./src/types/events.ts",
      "types": "./src/types/events.ts"
    },
    "./types/api": {
      "import": "./src/types/api.ts",
      "types": "./src/types/api.ts"
    },
    "./types/execution": {
      "import": "./src/types/execution.ts",
      "types": "./src/types/execution.ts"
    },
    "./types/runner": {
      "import": "./src/types/runner.ts",
      "types": "./src/types/runner.ts"
    },
    "./composables": {
      "import": "./src/composables/index.ts",
      "types": "./src/composables/index.ts"
    },
    "./utils/*": {
      "import": "./src/utils/*",
      "types": "./src/utils/*"
    },
    "./src/*": {
      "import": "./src/*",
      "types": "./src/*"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "marked": "^18.0.14",
    "mermaid": "^12.0.0",
    "monaco-editor": "^0.56.0",
    "monaco-editor-vue3": "^1.0.5",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "happy-dom": "20.14.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
