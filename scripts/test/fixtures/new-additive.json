{
  "openapi": "3.0.1",
  "info": { "title": "fixture", "version": "1.0.0" },
  "paths": {
    "/widgets": {
      "get": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "count": { "type": "integer" },
                  "color": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id"],
                  "properties": {
                    "id": { "type": "string" },
                    "kind": { "type": "string", "enum": ["A", "B", "C"] },
                    "weight": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sprockets": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
