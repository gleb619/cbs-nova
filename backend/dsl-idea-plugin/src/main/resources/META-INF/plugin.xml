<idea-plugin>
  <id>cbs.nova.dsl.idea</id>
  <name>cbs-nova DSL Support</name>
  <vendor>cbs-nova</vendor>
  <description>Thin IDE layer for cbs-nova compact DSL/model sources. Delegates compilation to the cbs.nova.dsl Gradle plugin.</description>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.java</depends>
  <depends>com.intellij.gradle</depends>

  <extensions defaultExtensionNs="com.intellij">
    <fileType name="CbsDsl" implementationClass="cbs.nova.dsl.idea.CbsDslFileType" fieldName="INSTANCE" language="CbsDsl" extensions=""/>
    <lang.syntaxHighlighterFactory language="CbsDsl" implementationClass="cbs.nova.dsl.idea.CbsDslSyntaxHighlighterFactory"/>
    <fileTypeOverrider implementation="cbs.nova.dsl.idea.DslFileTypeOverrider"/>
    <!--
      Real extension point name confirmed via javap/plugin.xml inspection of the bundled
      com.intellij.gradle plugin (IC 2023.3.5): externalSystemTaskNotificationListener is a
      top level com.intellij extension, not a Gradle specific one. onSuccess fires at the end of
      a RESOLVE_PROJECT task, i.e. end of Gradle sync, after data import into the IDE model.
    -->
    <externalSystemTaskNotificationListener implementation="cbs.nova.dsl.idea.sync.DslGradleSyncNotificationListener"/>
  </extensions>

  <!--
    Real extension point for Gradle project resolver extensions, confirmed via javap/plugin.xml
    inspection of gradle.jar (IC 2023.3.5): org.jetbrains.plugins.gradle.projectResolve under
    defaultExtensionNs="org.jetbrains.plugins.gradle" (not com.intellij.gradle.projectResolve).
  -->
  <extensions defaultExtensionNs="org.jetbrains.plugins.gradle">
    <projectResolve implementation="cbs.nova.dsl.idea.sync.DslProjectResolverExtension"/>
  </extensions>

  <actions>
    <action id="cbs.nova.dsl.idea.CompileDslAction" class="cbs.nova.dsl.idea.CompileDslAction" text="Compile DSL Sources" description="Runs ./gradlew :&lt;module&gt;:compileDsl">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
